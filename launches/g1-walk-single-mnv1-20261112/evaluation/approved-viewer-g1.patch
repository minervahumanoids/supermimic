--- /dev/null
+++ b/experiments/ali-baseline-prototype-20261112/g1_comparison.py
@@ -0,0 +1,46 @@
+"""Load a source-bound G1 comparison into the approved viewer and controls."""
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def load_comparison(path):
+    profile = json.loads(Path(path).read_text())
+    assert profile['robot'] == 'G1'
+    assert sha(profile['plant']['model_path']) == profile['plant']['model_sha256']
+    assert len(profile['selection']['clips']) == 1
+    clip = profile['selection']['clips'][0]
+    assert clip['clip'] == 'clip_6659630b5d665786' and clip['frames'] == 214
+    assert sha(clip['original_human']) == clip['original_human_sha256']
+    binding = profile['bindings']['bindings'][0]
+    assert binding['clip'] == clip['clip']
+    assert sha(binding['reference']) == binding['reference_sha256']
+    contracts = set()
+    versions = set()
+    for lane, policy in profile['bindings']['policies'].items():
+        assert sha(policy['report']) == policy['report_sha256']
+        report = json.loads(Path(policy['report']).read_text())
+        assert report['backend'] == 'standalone CPU MuJoCo'
+        assert report['optimizer_steps'] == 0 and report['wandb_initialized'] is False
+        assert report['policy_modified'] is False and len(report['trials']) == 1
+        assert report['trials'][0]['clip'] == clip['clip']
+        assert report['policy_sha256'] == policy['actor_sha256']
+        contracts.add(report['plant_contract_sha256'])
+        versions.add((report['mujoco_version'], report['torch_version'], report['control_dt']))
+        record = binding['policies'][lane]
+        assert sha(record['recording']) == record['recording_sha256']
+        assert sha(record['metrics']) == record['metrics_sha256']
+    assert len(contracts) == len(versions) == 1
+    assert next(iter(versions)) == ('3.15.0', '2.15.0+cpu', .02)
+    assert sha(profile['summary_path']) == profile['summary_sha256']
+    return profile, dict(passed=True, robot='G1', requested_clips=1, requested_frames=214,
+                         matched_policies=2, backend='standalone CPU MuJoCo',
+                         mujoco_version='3.15.0', torch_version='2.15.0+cpu',
+                         original_human_verified=True, same_native_physics=True,
+                         fixed_default_cohorts_unchanged=True)
