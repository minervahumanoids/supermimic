+"""Render the official G1 model inside the approved comparison viewer."""
+
+import mujoco
+import numpy as np
+from scipy.spatial.transform import Rotation
+import trimesh
+
+
+class G1Robot:
+    """Keep native visible geometry, site markers, and MuJoCo colors."""
+
+    def __init__(self, server, name, model, joints, offset):
+        self.model, self.offset = model, np.array(offset)
+        self.data = mujoco.MjData(model)
+        self.scene = mujoco.MjvScene(model, maxgeom=1000)
+        self.options, self.camera = mujoco.MjvOption(), mujoco.MjvCamera()
+        self.addresses = [int(model.joint(joint).qposadr[0]) for joint in joints]
+        self.nodes, self.geometry_ids = [], []
+        self.update_scene()
+        for i in range(self.scene.ngeom):
+            geom = self.scene.geoms[i]
+            if geom.type == mujoco.mjtGeom.mjGEOM_MESH:
+                mesh = int(model.geom_dataid[geom.objid])
+                va, vn = model.mesh_vertadr[mesh], model.mesh_vertnum[mesh]
+                fa, fn = model.mesh_faceadr[mesh], model.mesh_facenum[mesh]
+                vertices = model.mesh_vert[va:va+vn].copy()
+                faces = model.mesh_face[fa:fa+fn].copy()
+            elif geom.type == mujoco.mjtGeom.mjGEOM_PLANE:
+                # The approved viewer already draws one shared world grid.
+                # Keep original human coordinates visible below that reference plane.
+                continue
+            elif geom.type == mujoco.mjtGeom.mjGEOM_SPHERE:
+                primitive = trimesh.creation.icosphere(subdivisions=2,radius=geom.size[0])
+                vertices, faces = primitive.vertices, primitive.faces
+            else:
+                raise ValueError(f'Unsupported native G1 visible geometry: {geom.type}')
+            self.geometry_ids.append(i)
+            self.nodes.append(server.scene.add_mesh_simple(
+                f'/{name}/geom-{i}',vertices,faces,
+                color=tuple(int(x*255) for x in geom.rgba[:3]),opacity=float(geom.rgba[3]),
+                position=geom.pos+self.offset,
+                wxyz=Rotation.from_matrix(geom.mat.reshape(3,3)).as_quat()[[3,0,1,2]]))
+
+    def update_scene(self):
+        mujoco.mj_forward(self.model,self.data)
+        mujoco.mjv_updateScene(self.model,self.data,self.options,None,self.camera,
+                              mujoco.mjtCatBit.mjCAT_ALL,self.scene)
+
+    def show(self,root,quaternion,q,*,visible=True):
+        self.data.qpos[:3],self.data.qpos[3:7] = root,quaternion
+        self.data.qpos[self.addresses] = q
+        self.update_scene()
+        for i,node in zip(self.geometry_ids,self.nodes,strict=True):
+            geom = self.scene.geoms[i]
+            node.visible = visible
+            node.position = geom.pos+self.offset
+            node.wxyz = Rotation.from_matrix(geom.mat.reshape(3,3)).as_quat()[[3,0,1,2]]
